# ==============================================================================
# Environment Configuration Template (Example)
# ==============================================================================
# Copy this file to .env.local for local overrides.
# DO NOT store real credentials, production passwords, or sensitive keys here.
# ==============================================================================

# Image Registry & Tag
REPO=istana
TAG=2.1.0

# MongoDB Configuration
MONGO_PORT=27017

# Redis Configuration
REDIS_PORT=6379

# MySQL Configuration
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_ALLOW_EMPTY_PASSWORD=no
MYSQL_SHIPPING_DATABASE=cities
MYSQL_SHIPPING_USER=your_shipping_db_user
MYSQL_SHIPPING_PASSWORD=your_shipping_db_password
MYSQL_RATINGS_DATABASE=ratings
MYSQL_RATINGS_USER=your_ratings_db_user
MYSQL_RATINGS_PASSWORD=your_ratings_db_password

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
